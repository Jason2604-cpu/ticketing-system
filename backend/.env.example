
# Local dev over plain http://localhost — set false, otherwise the auth cookie is dropped
COOKIE_SECURE=false
# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to a random 32+ byte string in any real environment
JWT_SECRET=

# ── Email (activation / password-reset links) ─────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=Konoha HelpDesk <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:5173

# ── Media uploads ──────────────────────────────────────────────────────────
MEDIA_PATH=./media

# No admin credentials here: on first startup the backend creates admin@admin.com / admin
# and forces a password change at first sign-in (config/AdminBootstrap.java).
