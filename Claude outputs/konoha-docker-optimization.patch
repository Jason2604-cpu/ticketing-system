+
+# ── Schema: owned by Flyway ────────────────────────────────────────────────
+# Migrations live in src/main/resources/db/migration (V1 = baseline, V2+ = changes) and run on
+# startup. A database that Hibernate created before Flyway existed is recorded as V1 on first
+# contact (baseline-on-migrate) and then gets V2+. Hibernate only checks that the entities
+# match the tables; it never alters them. To change the schema, add V<n+1>__what.sql.
+spring.flyway.enabled=true
+spring.flyway.locations=classpath:db/migration
+spring.flyway.baseline-on-migrate=true
+spring.flyway.baseline-version=1
+spring.jpa.hibernate.ddl-auto=${DDL_AUTO:validate}
 spring.jpa.open-in-view=false
 
+# Hibernate performance:
+# - batch_fetch_size turns "one SELECT per row" lazy/eager loads of to-one associations into
+#   IN (...) batches, which removes the N+1 on every list (tickets, users, templates, audit...).
+# - jdbc.batch_size + order_updates batch UPDATE/DELETE statements (INSERTs use IDENTITY ids
+#   and cannot be batched by Hibernate).
+# - in_clause_parameter_padding keeps IN-list query plans cacheable.
+spring.jpa.properties.hibernate.default_batch_fetch_size=64
+spring.jpa.properties.hibernate.jdbc.batch_size=50
+spring.jpa.properties.hibernate.order_updates=true
+spring.jpa.properties.hibernate.query.in_clause_parameter_padding=true
