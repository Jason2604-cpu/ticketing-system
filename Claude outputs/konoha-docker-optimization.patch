+# Connection pool (HikariCP). 10 is plenty for one backend container; Postgres' default
+# max_connections is 100, so keep DB_POOL_SIZE x backend replicas well below that.
+spring.datasource.hikari.maximum-pool-size=${DB_POOL_SIZE:10}
