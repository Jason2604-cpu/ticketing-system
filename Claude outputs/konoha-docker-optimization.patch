@@ -1,74 +0,0 @@
-package com.konohahelpdesk.config;
-
-import org.slf4j.Logger;
-import org.slf4j.LoggerFactory;
-import org.springframework.boot.ApplicationArguments;
-import org.springframework.boot.ApplicationRunner;
-import org.springframework.core.annotation.Order;
-import org.springframework.stereotype.Component;
-
-import javax.sql.DataSource;
-import java.sql.Connection;
-import java.sql.Statement;
-
-/**
- * Replaces the old unconditional unique constraint on {@code users.email} with a partial
- * unique index that only covers live rows (status <> IS_DELETED).
- *
- * The {@link com.konohahelpdesk.model.user.User} entity used to declare {@code email} as
- * {@code @Column(unique = true)}, which Hibernate backs with a table-wide unique constraint —
- * that blocks re-inviting someone at an email address that belongs to a soft-deleted (removed)
- * user, even though every app-level duplicate check (see {@code UserRepository}) already
- * excludes IS_DELETED rows on purpose. Since {@code ddl-auto=update} only ever adds schema, it
- * never drops that old constraint on its own — this migration does it explicitly, once, then
- * creates the partial index so live emails are still protected at the DB level. Runs on every
- * startup; idempotent (the DO block is a no-op once the old constraint is gone, and the index
- * uses IF NOT EXISTS).
- */
-@Component
-@Order(1)
-public class EmailUniqueIndexMigration implements ApplicationRunner {
-
-    private static final Logger log = LoggerFactory.getLogger(EmailUniqueIndexMigration.class);
-
-    private final DataSource dataSource;
-
-    public EmailUniqueIndexMigration(DataSource dataSource) {
-        this.dataSource = dataSource;
-    }
-
-    @Override
-    public void run(ApplicationArguments args) throws Exception {
-        try (Connection conn = dataSource.getConnection(); Statement st = conn.createStatement()) {
-            st.execute("""
-                DO $$
-                DECLARE
-                    r RECORD;
-                BEGIN
-                    FOR r IN
-                        SELECT tc.constraint_name
-                        FROM information_schema.table_constraints tc
-                        JOIN information_schema.key_column_usage kcu
-                          ON tc.constraint_name = kcu.constraint_name
-                         AND tc.table_schema = kcu.table_schema
-                        WHERE tc.table_schema = current_schema()
-                          AND tc.table_name = 'users'
-                          AND tc.constraint_type = 'UNIQUE'
-                          AND kcu.column_name = 'email'
-                    LOOP
-                        EXECUTE format('ALTER TABLE users DROP CONSTRAINT %I', r.constraint_name);
-                    END LOOP;
-                END $$;
-                """);
-            st.execute("""
-                CREATE UNIQUE INDEX IF NOT EXISTS uq_users_email_active
-                ON users (email)
-                WHERE status <> 'IS_DELETED'
-                """);
-        } catch (Exception e) {
-            // Non-fatal: worst case is the old stricter constraint stays in place and a
-            // reused email keeps 409ing until this is retried on a later startup.
-            log.warn("Could not migrate users.email uniqueness to a partial index: {}", e.getMessage());
-        }
-    }
-}
