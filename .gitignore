# ===== BACKEND (Java/Maven) =====
target/
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# Environment
application-local.properties
application-local.yml

# Logs
*.log
logs/

# ===== FRONTEND (React/Vite) =====
node_modules/
dist/
dist-ssr/
build/

# Environment
.env
.env.local
.env.*.local
npm-debug.log*

# ===== IDE =====
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ===== OS =====
.DS_Store
Thumbs.db

# Uploaded media (photos, logos, attachments) — lives outside git. Anchored to the folders the app
# writes to (MEDIA_PATH defaults to ./media): a bare "media/" also matched the Java packages
# model/media, service/media, controller/media and repository/media, so they were never committed.
/media/
/backend/media/

# TLS certificates for the edge nginx (DEPLOYMENT.md step 9)
nginx/certs/*
!nginx/certs/.gitkeep

# Database dumps / backups
*.dump
backups/

# Claude working files (plans, screenshots, patches, archives): local only, never committed
/Claude outputs/

# SQL: only the Flyway migrations are committed; any other .sql (dumps, scratch) stays local
*.sql
!/backend/src/main/resources/db/migration/**/*.sql
