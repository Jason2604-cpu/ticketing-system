# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.
#   cp .env.docker.example .env
# Generate each secret with:  openssl rand -base64 48 | tr -d '\n=/+'
#
# There are NO admin credentials here: on first startup the backend creates
# admin@admin.com / admin and forces a password change at first sign-in.

# ── Public URL / port ──────────────────────────────────────────────────────
HTTP_PORT=80
# The address people type in the browser. Used in emailed links and as the allowed origin.
FRONTEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
# false while served over plain http; set true once nginx terminates HTTPS (DEPLOYMENT.md step 9).
COOKIE_SECURE=false
TZ=Asia/Kuala_Lumpur

# ── Database (the db container is created with these on first start) ──────
POSTGRES_DB=konoha_helpdesk
POSTGRES_USER=konoha
POSTGRES_PASSWORD=change-me
# Connection pool size per backend container.
DB_POOL_SIZE=10
# Postgres memory: ~25% / ~75% of the RAM you can give the database.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# ── Redis (rate limiting + login lockout counters) ─────────────────────────
REDIS_PASSWORD=change-me
# redis (default in Docker) | memory
APP_STORE_TYPE=redis

# ── Security ───────────────────────────────────────────────────────────────
# 32+ random bytes. Changing it signs everyone out.
JWT_SECRET=
# Flyway owns the schema (backend/src/main/resources/db/migration). Keep "validate".
DDL_AUTO=validate
# Keep true on exactly ONE backend container.
SCHEDULING_ENABLED=true

# ── Email ──────────────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Konoha HelpDesk <no-reply@example.com>
MAIL_SMTP_SSL=true 
MAIL_SMTP_STARTTLS=false
# ── Images from Docker Hub (only when deploying with docker-compose.prod.yml) ──
# The repository scripts/release.sh pushed to, and the version to run. Leave commented out
# when the server builds from source with the normal docker-compose.yml.
# DOCKER_REPO=youruser/konoha-helpdesk
# APP_VERSION=1.0.0
# COMPOSE_FILE=docker-compose.prod.yml
